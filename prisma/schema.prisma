// ============================================================
// FangwitBok V2 — Database Schema (PostgreSQL + Prisma)
// V3: เปิดให้โพสต์/คอมเมนต์/กดใจ/รายงานได้โดยไม่ต้องมีบัญชี (ระบุตัวตน/ไม่ระบุตัวตน
// ด้วย ownerToken แทนการล็อกอิน) + ระบบแจ้งปัญหา (SupportTicket) + กฎการฝากบอก (RuleBlock)
// บัญชีผู้ใช้ (User) ตอนนี้ใช้สำหรับ Admin/Super Admin เท่านั้น
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum PostType {
  ANNOUNCE // ฝากบอก
  LOST_FOUND // ตามหาของหาย
}

enum LostStatus {
  NOT_FOUND // ยังไม่เจอ
  FOUND // เจอของแล้ว
}

enum TargetType {
  POST
  COMMENT
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum NotificationType {
  NEW_POST
  NEW_REPORT
  POST_RESOLVED
  NEW_SUPPORT_TICKET
  SYSTEM
}

enum TicketStatus {
  OPEN
  CLOSED
}

enum MessageSender {
  VISITOR
  ADMIN
}

// ============================================================
// ผู้ใช้ — ปัจจุบันมีไว้สำหรับ Admin/Super Admin เท่านั้น (ผู้เยี่ยมชมทั่วไปไม่ต้องสมัคร)
// ============================================================
model User {
  id           String   @id @default(uuid())
  studentCode  String   @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  role         Role     @default(USER) // บัญชีสมัครเองเริ่มที่สิทธิ์ต่ำสุดเสมอ (ยกระดับได้เฉพาะ Super Admin)
  isBanned     Boolean  @default(false)
  bannedReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts          Post[]
  comments       Comment[]
  likes          Like[]
  reportsHandled Report[]        @relation("ReportsHandled")
  auditLogs      AuditLog[]
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  popupsCreated  Popup[]
  ruleBlocks     RuleBlock[]
  supportReplies SupportMessage[]
  roleChangesBy  RoleChangeLog[] @relation("RoleChangedBy")
  roleChangesOn  RoleChangeLog[] @relation("RoleChangedOn")

  @@index([role])
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============================================================
// โพสต์: ฝากบอก / ตามหาของหาย — โพสต์ได้โดยไม่ต้องมีบัญชี
// ============================================================
model Post {
  id          String      @id @default(uuid())
  type        PostType
  isAnonymous Boolean     @default(false) // true = "ไม่ระบุตัวตน" ไม่เก็บ/ไม่แสดงชื่อเลย
  content     String
  lostStatus  LostStatus?
  location    String?

  // ---------- ผู้โพสต์ ----------
  // ถ้าเลือก "ระบุตัวตน" (ไม่มีบัญชี): เก็บชื่อ/ชั้นห้องที่พิมพ์เองไว้ตรงนี้
  guestName      String?
  guestClassroom String?
  // ถ้าล็อกอินเป็น Admin ตอนโพสต์ (ไม่บังคับ): ผูกกับบัญชีจริง
  authorId       String?
  author         User?   @relation(fields: [authorId], references: [id])
  // พิสูจน์ความเป็นเจ้าของโพสต์แบบไม่มีบัญชี: เก็บ "hash" ของโทเคนสุ่มที่ส่งกลับให้ผู้โพสต์
  // ครั้งเดียวตอนสร้างโพสต์ (เหมือนรหัสผ่าน ไม่เก็บค่าจริง) ใช้ยืนยันตอนเปลี่ยนสถานะ/ลบโพสต์ภายหลัง
  ownerTokenHash String? @unique

  deletedAt   DateTime?
  deletedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images   PostImage[]
  comments Comment[]
  likes    Like[]
  reports  Report[]

  @@index([type, deletedAt])
  @@index([deletedAt])
}

model PostImage {
  id       String @id @default(uuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  url      String // URL สาธารณะจาก Supabase Storage (คงอยู่ถาวร ไม่หายเมื่อ deploy ใหม่)
  path     String // ตำแหน่งไฟล์จริงใน bucket (ใช้ตอนลบไฟล์)
  position Int    @default(0)

  @@index([postId])
}

model Comment {
  id          String    @id @default(uuid())
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  isAnonymous Boolean   @default(false)
  content     String

  guestName      String?
  authorId       String?
  author         User?   @relation(fields: [authorId], references: [id])
  ownerTokenHash String? @unique

  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime  @default(now())

  reports Report[]

  @@index([postId, deletedAt])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  // รองรับทั้งผู้เยี่ยมชม (ไม่มีบัญชี) และผู้ใช้ที่ล็อกอิน ด้วยคีย์เดียวกัน กันกดใจซ้ำ:
  // ผู้เยี่ยมชม -> "visitor:<สุ่มจาก localStorage>"   ผู้ใช้ล็อกอิน -> "user:<userId>"
  voterKey  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, voterKey])
}

// ============================================================
// รายงาน (Report/Moderation) — รายงานได้โดยไม่ต้องมีบัญชี
// ============================================================
model Report {
  id         String       @id @default(uuid())
  targetType TargetType
  postId     String?
  post       Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  reporterLabel String? // บันทึกไว้แค่เพื่อ debug/สถิติ ไม่ใช่ข้อมูลระบุตัวตนจริง เช่น "ผู้เยี่ยมชม"
  reason         String
  status         ReportStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation("ReportsHandled", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status])
}

// ============================================================
// Audit Log — append-only
// ============================================================
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model RoleChangeLog {
  id           String   @id @default(uuid())
  targetUserId String
  targetUser   User     @relation("RoleChangedOn", fields: [targetUserId], references: [id])
  fromRole     Role
  toRole       Role
  changedById  String
  changedBy    User     @relation("RoleChangedBy", fields: [changedById], references: [id])
  createdAt    DateTime @default(now())
}

// ============================================================
// Popup ประกาศ
// ============================================================
model Popup {
  id          String    @id @default(uuid())
  title       String
  body        String
  imageUrl    String?
  imagePath   String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  startAt     DateTime?
  endAt       DateTime?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([isActive, order])
}

// ============================================================
// กฎการฝากบอก — Admin จัดเรียง/แก้ข้อความ/แนบรูปได้หลายบล็อก
// ============================================================
model RuleBlock {
  id          String   @id @default(uuid())
  order       Int      @default(0)
  heading     String?
  body        String?
  imageUrl    String?
  imagePath   String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([order])
}

// ============================================================
// แจ้งปัญหา (Support Chat) — ผู้เยี่ยมชมคุยกับแอดมินโดยไม่ต้องมีบัญชี
// ยืนยันตัวตนเจ้าของ ticket ด้วย visitorTokenHash เหมือนกลไกของโพสต์/คอมเมนต์
// ============================================================
model SupportTicket {
  id               String       @id @default(uuid())
  visitorTokenHash String       @unique
  status           TicketStatus @default(OPEN)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  messages SupportMessage[]

  @@index([status])
}

model SupportMessage {
  id             String        @id @default(uuid())
  ticketId       String
  ticket         SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender         MessageSender
  senderAdminId  String?
  senderAdmin    User?         @relation(fields: [senderAdminId], references: [id])
  content        String
  createdAt      DateTime      @default(now())

  @@index([ticketId])
}

// ============================================================
// การแจ้งเตือน (Admin)
// ============================================================
model Notification {
  id          String           @id @default(uuid())
  recipientId String?
  recipient   User?            @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type        NotificationType
  title       String
  body        String
  relatedType String?
  relatedId   String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([recipientId, isRead])
}

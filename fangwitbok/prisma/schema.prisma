// ============================================================
// FangwitBok V2 — Database Schema (PostgreSQL + Prisma)
// Phase 1: โครงสร้างข้อมูล + RBAC ทั้งระบบ
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- สิทธิ์ผู้ใช้: Super Admin > Admin > User ----------
enum Role {
  SUPER_ADMIN
  ADMIN
  USER
}

enum PostType {
  ANNOUNCE // ฝากบอก
  LOST_FOUND // ตามหาของหาย
}

enum LostStatus {
  NOT_FOUND // ยังไม่เจอ
  FOUND // เจอของแล้ว
}

enum TargetType {
  POST
  COMMENT
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum NotificationType {
  NEW_POST
  NEW_REPORT
  POST_RESOLVED
  SYSTEM
}

// ============================================================
// ผู้ใช้
// ============================================================
model User {
  id           String   @id @default(uuid())
  studentCode  String   @unique // รหัสนักเรียน/อีเมลโรงเรียน — ใช้ล็อกอิน
  passwordHash String
  displayName  String
  avatarUrl    String?
  role         Role     @default(USER)
  isBanned     Boolean  @default(false)
  bannedReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  posts         Post[]
  comments      Comment[]
  likes         Like[]
  reportsFiled  Report[]      @relation("ReportsFiled")
  reportsHandled Report[]     @relation("ReportsHandled")
  auditLogs     AuditLog[]
  notifications Notification[]
  refreshTokens RefreshToken[]
  popupsCreated Popup[]
  roleChangesBy RoleChangeLog[] @relation("RoleChangedBy")
  roleChangesOn RoleChangeLog[] @relation("RoleChangedOn")

  @@index([role])
}

// ล็อกอินด้วย refresh token (เก็บเป็น hash เท่านั้น รองรับ revoke รายอุปกรณ์)
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ============================================================
// โพสต์: ฝากบอก / ตามหาของหาย
// ============================================================
model Post {
  id          String     @id @default(uuid())
  type        PostType
  authorId    String
  author      User       @relation(fields: [authorId], references: [id])
  isAnonymous Boolean    @default(false) // true = ไม่แสดงชื่อผู้โพสต์ต่อสาธารณะ
  content     String
  lostStatus  LostStatus? // ใช้เฉพาะ type = LOST_FOUND
  location    String? // จุดที่พบ/ทำหาย (สำหรับตามหาของหาย)

  // Soft delete / Trash: ลบแล้วย้ายมาที่นี่ก่อน ลบถาวรอัตโนมัติเมื่อเกิน 15 วัน
  deletedAt   DateTime?
  deletedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images   PostImage[]
  comments Comment[]
  likes    Like[]
  reports  Report[]

  @@index([type, deletedAt])
  @@index([deletedAt]) // ใช้สำหรับ job ลบถาวรอัตโนมัติ (deletedAt < now-15d)
}

model PostImage {
  id       String @id @default(uuid())
  postId   String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  url      String
  position Int    @default(0)

  @@index([postId])
}

model Comment {
  id          String    @id @default(uuid())
  postId      String
  post        Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])
  isAnonymous Boolean   @default(false)
  content     String
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime  @default(now())

  reports Report[]

  @@index([postId, deletedAt])
}

model Like {
  id        String   @id @default(uuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId]) // กดใจซ้ำไม่ได้ (ป้องกันสแปมนับใจปลอม)
}

// ============================================================
// รายงาน (Report/Moderation)
// ============================================================
model Report {
  id         String       @id @default(uuid())
  targetType TargetType
  postId     String?
  post       Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  commentId  String?
  comment    Comment?     @relation(fields: [commentId], references: [id], onDelete: Cascade)

  reporterId String
  reporter   User         @relation("ReportsFiled", fields: [reporterId], references: [id])
  reason     String
  status     ReportStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation("ReportsHandled", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status])
}

// ============================================================
// Audit Log — บันทึกทุกการกระทำสำคัญของ Admin/Super Admin
// (ใครทำอะไร เมื่อไร กับข้อมูลอะไร) ห้ามแก้ไข/ลบภายหลัง (append-only)
// ============================================================
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String // เช่น "POST_DELETE", "POST_RESTORE", "REPORT_RESOLVE", "ROLE_CHANGE"
  targetType String // "POST" | "COMMENT" | "USER" | "REPORT" | "POPUP"
  targetId   String
  metadata   Json? // รายละเอียดเพิ่มเติม (ค่าก่อน/หลัง ฯลฯ)
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}

// บันทึกแยกเฉพาะการเปลี่ยนสิทธิ์ผู้ใช้ (ตรวจสอบย้อนหลังง่าย + ป้องกันการเลื่อนสิทธิ์ตัวเอง)
model RoleChangeLog {
  id          String   @id @default(uuid())
  targetUserId String
  targetUser   User    @relation("RoleChangedOn", fields: [targetUserId], references: [id])
  fromRole    Role
  toRole      Role
  changedById String
  changedBy   User     @relation("RoleChangedBy", fields: [changedById], references: [id])
  createdAt   DateTime @default(now())
}

// ============================================================
// Popup ประกาศ (Admin สร้างได้หลายรายการ กำหนดลำดับ/ช่วงเวลาแสดงผล)
// ============================================================
model Popup {
  id          String    @id @default(uuid())
  title       String
  body        String
  imageUrl    String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  startAt     DateTime?
  endAt       DateTime?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([isActive, order])
}

// ============================================================
// การแจ้งเตือน (สำหรับ Admin: โพสต์ใหม่ / รายงานใหม่ / เหตุการณ์สำคัญ)
// ============================================================
model Notification {
  id            String            @id @default(uuid())
  recipientId   String? // null = แจ้งเตือนกว้างถึง Admin ทุกคน (ดูจาก role ตอน query)
  recipient     User?             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  type          NotificationType
  title         String
  body          String
  relatedType   String?
  relatedId     String?
  isRead        Boolean           @default(false)
  createdAt     DateTime          @default(now())

  @@index([recipientId, isRead])
}

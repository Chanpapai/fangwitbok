# ฐานข้อมูล PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/fangwitbok"

# JWT secrets — ต้องเป็นค่าสุ่มยาว ๆ ห้ามใช้ค่าตัวอย่างนี้จริง
# สร้างด้วยคำสั่ง: openssl rand -hex 64
JWT_ACCESS_SECRET="เปลี่ยนเป็นค่าสุ่มยาว ๆ"
JWT_REFRESH_SECRET="เปลี่ยนเป็นค่าสุ่มยาว ๆ อีกค่าหนึ่ง (ห้ามซ้ำกับตัวบน)"

# โดเมนหน้าเว็บที่อนุญาตให้เรียก API (คั่นด้วย , ถ้ามีหลายโดเมน)
CORS_ORIGIN="http://localhost:5173"

PORT=4000
NODE_ENV=development

# ทางเลือกที่ 1 (ใช้ตอนมี terminal ในเครื่อง): รัน "npm run seed" เพื่อสร้าง Super Admin คนแรก
SEED_ADMIN_CODE=admin001
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=ผู้ดูแลระบบ

# ทางเลือกที่ 2 (ไม่มี terminal/ไม่ได้ติดตั้งอะไรในเครื่อง): เปิดหน้าเว็บ
# https://โดเมนเซิร์ฟเวอร์คุณ/api/setup?token=ค่านี้ แล้วกรอกฟอร์มสร้าง Super Admin ผ่านเบราว์เซอร์ได้เลย
# ต้องเป็นค่าสุ่มยาว ๆ คาดเดายาก — ใช้ปุ่ม "Generate" ของผู้ให้บริการ hosting ได้เลยถ้ามี
SETUP_SECRET="เปลี่ยนเป็นค่าสุ่มยาว ๆ"

# ---------- ฐานข้อมูล: Supabase Postgres (Project Settings > Database > Connection string) ----------
# DATABASE_URL = Transaction pooler (พอร์ต 6543) ต่อท้ายด้วย ?pgbouncer=true&connection_limit=1  <- ใช้ตอนรันจริง
# DIRECT_URL   = Session pooler (พอร์ต 5432 ของ host pooler) <- ใช้ตอน build เพื่อสร้างตาราง (รองรับ IPv4 ของ Render)
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-xx.pooler.supabase.com:5432/postgres"

# ---------- ที่เก็บรูปถาวร: Supabase Storage ----------
SUPABASE_URL="https://xxxx.supabase.co"
# service_role key (Project Settings > API) — ลับสุดยอด ใส่ที่ Backend เท่านั้น ห้ามใส่ในหน้าเว็บ/GitHub
SUPABASE_SERVICE_ROLE_KEY="เปลี่ยนเป็นค่าจริง"
SUPABASE_BUCKET="fangwitbok"

# ---------- JWT (เฉพาะ Admin) — ค่าสุ่มยาว ๆ คนละค่ากัน: openssl rand -hex 64 ----------
JWT_ACCESS_SECRET="เปลี่ยนเป็นค่าสุ่มยาว ๆ"
JWT_REFRESH_SECRET="เปลี่ยนเป็นค่าสุ่มยาว ๆ อีกค่าหนึ่ง"

# โดเมนหน้าเว็บที่อนุญาตให้เรียก API (คั่นด้วย , ถ้ามีหลายโดเมน) ต้องตรงทุกตัวอักษร ไม่มี / ท้าย
CORS_ORIGIN="http://localhost:5173"

PORT=4000
NODE_ENV=development

# สร้าง Super Admin คนแรก ทางเลือก 1: npm run seed (เข้าสู่ระบบด้วย "ชื่อจริง" + รหัสผ่าน)
SEED_ADMIN_PASSWORD=changeme123
SEED_ADMIN_NAME=ผู้ดูแลระบบ

# ทางเลือก 2 (ไม่ต้องใช้ terminal): เปิด https://โดเมนAPI/api/setup?token=ค่านี้
SETUP_SECRET="เปลี่ยนเป็นค่าสุ่มยาว ๆ"
